{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2022"],
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "noEmit": true,
    // The workspace hoists @types/node under packages/react.
    "typeRoots": ["../packages/react/node_modules/@types"],
    "types": ["node"]
  },
  "include": ["*.ts"]
}
