{
  "name": "@gpuix/core",
  "version": "0.4.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/remorses/gpuix"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "node -e \"if (!process.env.CI) { console.error('Never publish @gpuix/core locally. CI is the only release path. See AGENTS.md.'); process.exit(1) }\"",
    "build": "rm -rf dist *.tsbuildinfo && tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@gpuix/native": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  }
}
